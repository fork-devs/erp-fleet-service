# ==============================================================================
# ERP FLEET SERVICE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server configuration
SERVER_PORT=8083

# Database configuration (PostgreSQL erp_fleet_db)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5435/erp_fleet_db
SPRING_DATASOURCE_USERNAME=fleet_user
SPRING_DATASOURCE_PASSWORD=fleet_secret

# Auth service JWKS URI
AUTH_JWKS_URI=http://localhost:8081/oauth2/jwks

# Integration hub URL
INTEGRATION_HUB_URL=http://localhost:8085
