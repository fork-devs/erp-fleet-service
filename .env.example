# ==============================================================================
# ERP FLEET SERVICE - ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# Este fichero declara los NOMBRES de las variables, nunca sus valores. Ningun
# secreto (contraseñas, claves de servicio) se escribe aqui: se resuelve por
# variable de entorno o por el almacen de secretos.
# ==============================================================================

# Server configuration
SERVER_PORT=8083

# Database configuration (PostgreSQL erp_fleet_db)
#
# SPRING_DATASOURCE_USERNAME es el rol de EJECUCION: no es propietario de las
# tablas, porque el propietario elude su propia politica de Row-Level Security.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5435/erp_fleet_db
SPRING_DATASOURCE_USERNAME=erp_fleet_app
SPRING_DATASOURCE_PASSWORD=

# Rol con el que se ejecutan las migraciones (propietario del esquema)
SPRING_FLYWAY_USER=erp_fleet_owner
SPRING_FLYWAY_PASSWORD=

# Auth service JWKS URL
#
# El conjunto de claves se publica en /.well-known/jwks.json. Debe usar https
# fuera del perfil de desarrollo local.
JWKS_URL=https://auth.erp-automotriz.com/.well-known/jwks.json

# Integration hub
#
# fleet llama al hub por HTTPS, con su PROPIA clave de servicio. El hub le
# concede el rol acotado ROLE_FLEET.
INTEGRATION_HUB_URL=https://integration-hub.erp-automotriz.com
INTEGRATION_HUB_KEY=
INTEGRATION_HUB_SERVICE_NAME=erp-fleet-service

# Cache de validaciones (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
VALIDACION_CACHE_RUC_TTL=30d
VALIDACION_CACHE_PLACA_TTL=7d

# Barrido de revalidacion
REVALIDACION_MAX_POR_TALLER=10
REVALIDACION_INTERVALO=60s
